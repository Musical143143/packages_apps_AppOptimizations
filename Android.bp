// App Optimisation: clears junk (app caches) and boosts RAM (stops background apps).
// Built into the platform image as a privileged app signed with the platform key,
// so it inherits the system-only permissions declared in its manifest.
android_app {
    name: "AppOptimization",
    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    static_libs: [
        "androidx.activity_activity-compose",
        "androidx.compose.material3_material3",
        "androidx.compose.runtime_runtime",
        "androidx.compose.foundation_foundation",
        "androidx.compose.ui_ui",
        "androidx.lifecycle_lifecycle-runtime-ktx",
        "kotlinx_coroutines",
    ],
    min_sdk_version: "31",
    target_sdk_version: "current",
}

// Installs the privileged permission whitelist for this app.
prebuilt_etc {
    name: "privapp-permissions-appoptimization",
    src: "privapp-permissions-appoptimization.xml",
    sub_dir: "permissions",
}
